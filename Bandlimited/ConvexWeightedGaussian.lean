module

public import Bandlimited.Definitions
public import Bandlimited.TensorDensity
public import Bandlimited.GaussianCutoff
public import Mathlib.Analysis.Convex.Approximation
public import Mathlib.Analysis.InnerProductSpace.Dual
public import Mathlib.LinearAlgebra.Basis.VectorSpace
public import Mathlib.Analysis.SpecialFunctions.Pow.NNReal

/-!
# Convex-weight Gaussian approximation

The active subspace is generated by slopes of all global affine minorants.
Mathlib's affine approximation theorem for continuous convex functions supplies
these slopes. This avoids assuming differentiability or an unproved
almost-everywhere gradient argument.
-/
@[expose] public section
open scoped BigOperators RealInnerProductSpace
open Set
noncomputable section
namespace Bandlimited
namespace ConvexGaussian

theorem profile_continuous {d : ℕ} {f : E d → ℝ} (hf : IsConvexProfile f) :
    Continuous f := by
  obtain ⟨C, hC, hbound⟩ := hf.2.2.2
  have hlip : LipschitzWith ⟨C, hC⟩ f := LipschitzWith.of_dist_le_mul fun x y => by
    change dist (f x) (f y) ≤ C * dist x y
    simpa only [Real.dist_eq, dist_eq_norm, Real.norm_eq_abs] using hbound x y
  exact hlip.continuous

def minorantVectors {d : ℕ} (f : E d → ℝ) : Set (E d) :=
  {a | ∃ c : ℝ, ∀ x, ⟪a, x⟫ + c ≤ f x}

def activeSubspace {d : ℕ} (f : E d → ℝ) : Submodule ℝ (E d) :=
  Submodule.span ℝ (minorantVectors f)

/-- Every strict lower value of a continuous convex profile is attained by a
continuous affine minorant, with its slope represented by the Euclidean inner product. -/
theorem profile_affine_minorant_near {d : ℕ} {f : E d → ℝ}
    (hf : IsConvexProfile f) (x : E d) (a : ℝ) (ha : a < f x) :
    ∃ v : E d, ∃ c : ℝ, (∀ y, ⟪v, y⟫ + c ≤ f y) ∧ ⟪v, x⟫ + c = a := by
  obtain ⟨l, c, hle, heq⟩ := ConvexOn.exists_affine_le_of_lt (𝕜 := ℝ)
    (s := Set.univ) (φ := f) (x := x) (a := a) (mem_univ x) ha isClosed_univ
    (profile_continuous hf).continuousOn.lowerSemicontinuousOn hf.1
  let v : E d := (InnerProductSpace.toDual ℝ (E d)).symm l
  refine ⟨v, c, ?_, ?_⟩
  · intro y
    simpa [v, InnerProductSpace.toDual_symm_apply] using hle ⟨y, mem_univ y⟩
  · simpa [v, InnerProductSpace.toDual_symm_apply] using heq

/-- The convex profile is constant on every translate of the orthogonal
complement of its active subspace. This is proved from affine minorants. -/
theorem profile_constant_on_orthogonal_fibres {d : ℕ} {f : E d → ℝ}
    (hf : IsConvexProfile f) (x z : E d) (hz : z ∈ (activeSubspace f)ᗮ) :
    f (x + z) = f x := by
  apply le_antisymm
  · by_contra hnot
    have hstrict : f x < f (x + z) := lt_of_not_ge hnot
    obtain ⟨v, c, hle, heq⟩ := profile_affine_minorant_near hf (x + z)
      ((f x + f (x + z)) / 2) (by linarith)
    have hv : v ∈ activeSubspace f := Submodule.subset_span ⟨c, hle⟩
    have hvz : ⟪v, z⟫ = 0 := hz v hv
    have hlo := hle x
    rw [inner_add_right, hvz, add_zero] at heq
    linarith
  · by_contra hnot
    have hstrict : f (x + z) < f x := lt_of_not_ge hnot
    obtain ⟨v, c, hle, heq⟩ := profile_affine_minorant_near hf x
      ((f x + f (x + z)) / 2) (by linarith)
    have hv : v ∈ activeSubspace f := Submodule.subset_span ⟨c, hle⟩
    have hvz : ⟪v, z⟫ = 0 := hz v hv
    have hlo := hle (x + z)
    rw [inner_add_right, hvz, add_zero] at hlo
    linarith

theorem minorant_offset_nonpos {d : ℕ} {f : E d → ℝ} (hf : IsConvexProfile f)
    (v : E d) (c : ℝ) (hle : ∀ y, ⟪v, y⟫ + c ≤ f y) : c ≤ 0 := by
  simpa only [inner_zero_right, zero_add, hf.2.2.1] using hle 0

theorem positive_coordinates_sum_bound {d r : ℕ} {f : E d → ℝ}
    (hnn : ∀ x, 0 ≤ f x) (v : Fin r → E d) (C : Fin r → ℝ)
    (hC : ∀ i, 0 ≤ C i) (hle : ∀ i x, ⟪v i, x⟫ - C i ≤ f x) (x : E d) :
    (∑ i : Fin r, max ⟪v i, x⟫ 0) ≤ (r : ℝ) * f x + ∑ i : Fin r, C i := by
  calc
    (∑ i : Fin r, max ⟪v i, x⟫ 0) ≤ ∑ i : Fin r, (f x + C i) := by
      apply Finset.sum_le_sum
      intro i hi
      exact max_le (by linarith [hle i x]) (by linarith [hnn x, hC i])
    _ = (r : ℝ) * f x + ∑ i : Fin r, C i := by simp [Finset.sum_add_distrib]

theorem profile_zero_of_active_eq_bot {d : ℕ} {f : E d → ℝ}
    (hf : IsConvexProfile f) (hS : activeSubspace f = ⊥) : ∀ x, f x = 0 := by
  intro x
  have hz : x ∈ (activeSubspace f)ᗮ := by rw [hS]; simp
  simpa only [zero_add, hf.2.2.1] using profile_constant_on_orthogonal_fibres hf 0 x hz

/-- A finite independent family of actual affine-minorant slopes spans the
active subspace. The offsets are nonnegative because f(0)=0. -/
theorem profile_supporting_basis {d : ℕ} {f : E d → ℝ} (hf : IsConvexProfile f) :
    ∃ v : Fin (Module.finrank ℝ (activeSubspace f)) → E d,
      ∃ C : Fin (Module.finrank ℝ (activeSubspace f)) → ℝ,
        LinearIndependent ℝ v ∧ Submodule.span ℝ (range v) = activeSubspace f ∧
          (∀ i, 0 ≤ C i) ∧ ∀ i x, ⟪v i, x⟫ - C i ≤ f x := by
  classical
  obtain ⟨v, hv, hspan, hind⟩ :=
    Submodule.exists_fun_fin_finrank_span_eq ℝ (minorantVectors f)
  choose c hc using hv
  refine ⟨v, fun i => -c i, hind, hspan, ?_, ?_⟩
  · intro i
    exact neg_nonneg.mpr (minorant_offset_nonpos hf (v i) (c i) (hc i))
  · intro i x
    simpa only [sub_neg_eq_add] using hc i x


/-- Coordinates given by the inner products with a spanning family. -/
def slopeCoordinates {d r : ℕ} (S : Submodule ℝ (E d)) (v : Fin r → E d) :
    S →ₗ[ℝ] E r where
  toFun x := WithLp.toLp 2 (fun i => ⟪v i, (x : E d)⟫)
  map_add' x y := by
    ext i
    simp only [Submodule.coe_add, inner_add_right, PiLp.add_apply]
  map_smul' c x := by
    ext i
    simp only [Submodule.coe_smul, real_inner_smul_right,
      PiLp.smul_apply, smul_eq_mul, RingHom.id_apply]

@[simp] theorem slopeCoordinates_apply {d r : ℕ} (S : Submodule ℝ (E d))
    (v : Fin r → E d) (x : S) (i : Fin r) :
    slopeCoordinates S v x i = ⟪v i, (x : E d)⟫ := rfl

theorem slopeCoordinates_injective {d r : ℕ} (S : Submodule ℝ (E d))
    (v : Fin r → E d) (hspan : Submodule.span ℝ (range v) = S) :
    Function.Injective (slopeCoordinates S v) := by
  intro x y hxy
  have hzero : ∀ i, ⟪v i, ((x - y : S) : E d)⟫ = 0 := by
    intro i
    have hi := congrArg (fun z : E r => z i) hxy
    change ⟪v i, (x : E d)⟫ = ⟪v i, (y : E d)⟫ at hi
    simpa only [Submodule.coe_sub, inner_sub_right, sub_eq_zero] using hi
  have horth : ((x - y : S) : E d) ∈ Sᗮ := by
    intro a ha
    rw [← hspan] at ha
    induction ha using Submodule.span_induction with
    | mem a ha =>
        obtain ⟨i, rfl⟩ := ha
        exact hzero i
    | zero => simp
    | add a b ha hb hia hib => simp only [inner_add_left, hia, hib, add_zero]
    | smul c a ha hia => simp only [real_inner_smul_left, hia, mul_zero]
  apply sub_eq_zero.mp
  apply Subtype.ext
  exact inner_self_eq_zero.mp (horth _ (x - y).property)

/-- The supporting inner products form an invertible coordinate map on the
active subspace, including the rank-zero case. -/
def slopeCoordinateEquiv {d : ℕ} (S : Submodule ℝ (E d))
    (v : Fin (Module.finrank ℝ S) → E d)
    (hspan : Submodule.span ℝ (range v) = S) :
    S ≃L[ℝ] E (Module.finrank ℝ S) :=
  ((slopeCoordinates S v).linearEquivOfInjective
    (slopeCoordinates_injective S v hspan) (by simp [E])).toContinuousLinearEquiv

@[simp] theorem slopeCoordinateEquiv_apply {d : ℕ} (S : Submodule ℝ (E d))
    (v : Fin (Module.finrank ℝ S) → E d)
    (hspan : Submodule.span ℝ (range v) = S) (x : S)
    (i : Fin (Module.finrank ℝ S)) :
    slopeCoordinateEquiv S v hspan x i = ⟪v i, (x : E d)⟫ := rfl

/-- A fixed coordinate map gives a polynomial comparison uniform in A ≥ 1. -/
theorem coordinate_norm_bound {d : ℕ} (S : Submodule ℝ (E d))
    (v : Fin (Module.finrank ℝ S) → E d)
    (hspan : Submodule.span ℝ (range v) = S) (t : E (Module.finrank ℝ S)) :
    ‖(slopeCoordinateEquiv S v hspan).symm t‖ ≤
      ‖(slopeCoordinateEquiv S v hspan).symm.toContinuousLinearMap‖ *
        ∑ i : Fin (Module.finrank ℝ S), |t i| := by
  let J := (slopeCoordinateEquiv S v hspan).symm.toContinuousLinearMap
  exact (J.le_opNorm t).trans
    (mul_le_mul_of_nonneg_left (TensorDensity.norm_le_sum_abs t) (norm_nonneg J))

/-- The elementary product inequality used to compare polynomial weights. -/
theorem one_add_sum_le_prod_one_add {ι : Type*} (s : Finset ι) (b : ι → ℝ)
    (hb : ∀ i ∈ s, 0 ≤ b i) :
    1 + ∑ i ∈ s, b i ≤ ∏ i ∈ s, (1 + b i) := by
  classical
  induction s using Finset.induction_on with
  | empty => simp
  | @insert a s ha ih =>
      have has : ∀ i ∈ s, 0 ≤ b i := fun i hi => hb i (Finset.mem_insert_of_mem hi)
      have hba : 0 ≤ b a := hb a (Finset.mem_insert_self a s)
      have hsum : 0 ≤ ∑ i ∈ s, b i := Finset.sum_nonneg has
      have hih := ih has
      simp only [Finset.sum_insert ha, Finset.prod_insert ha]
      nlinarith



/-- Polynomial growth under any fixed linear change of coordinates. -/
theorem polynomial_coordinate_bound {r : ℕ} (t : E r) (N K A L : ℝ)
    (hN : 0 ≤ N) (hK : 1 ≤ K) (hA : 1 ≤ A) (hL : 0 ≤ L)
    (hbound : N ≤ K * ∑ i : Fin r, |t i|) :
    (1 + N / A) ^ L ≤ K ^ L * ∏ i : Fin r, (1 + |t i|) ^ L := by
  have hsum : 0 ≤ ∑ i : Fin r, |t i| := Finset.sum_nonneg fun i _ => abs_nonneg _
  have hprod : 1 + ∑ i : Fin r, |t i| ≤ ∏ i : Fin r, (1 + |t i|) :=
    one_add_sum_le_prod_one_add Finset.univ (fun i => |t i|) (fun i _ => abs_nonneg _)
  have hlin : 1 + N / A ≤ K * ∏ i : Fin r, (1 + |t i|) := by
    calc
      1 + N / A ≤ 1 + N := by linarith [div_le_self hN hA]
      _ ≤ K * (1 + ∑ i : Fin r, |t i|) := by nlinarith
      _ ≤ K * ∏ i : Fin r, (1 + |t i|) :=
        mul_le_mul_of_nonneg_left hprod (by linarith)
  calc
    (1 + N / A) ^ L ≤ (K * ∏ i : Fin r, (1 + |t i|)) ^ L :=
      Real.rpow_le_rpow (by positivity) hlin hL
    _ = K ^ L * ∏ i : Fin r, (1 + |t i|) ^ L := by
      rw [Real.mul_rpow (by linarith) (Finset.prod_nonneg fun i _ => by positivity),
        ← Real.finsetProd_rpow Finset.univ (fun i => 1 + |t i|)
          (fun i _ => by positivity)]

/-- The exponential part of the weight is controlled by the genuine affine
minorants. No uniform bound on the profile's Lipschitz constant is needed. -/
theorem exponential_coordinate_bound {r : ℕ} (t : E r) (b C : ℝ)
    (hb : 0 ≤ b) (hC : 0 ≤ C)
    (hbound : (∑ i : Fin r, max (t i) 0) ≤ (r : ℝ) * b + C) :
    Real.exp (-b) ≤ Real.exp C *
      ∏ i : Fin r, Real.exp (-((r : ℝ) + 1)⁻¹ * max (t i) 0) := by
  let c : ℝ := ((r : ℝ) + 1)⁻¹
  have hr : 0 ≤ (r : ℝ) := Nat.cast_nonneg _
  have hden : 0 < (r : ℝ) + 1 := by positivity
  have hc : 0 < c := inv_pos.mpr hden
  have hcone : c ≤ 1 := by
    dsimp [c]
    exact inv_le_one_of_one_le₀ (by linarith)
  have hcr : c * (r : ℝ) ≤ 1 := by
    dsimp [c]
    apply (inv_mul_le_iff₀ hden).2
    linarith
  have hmul := mul_le_mul_of_nonneg_left hbound hc.le
  have hfb : c * (r : ℝ) * b ≤ b := by nlinarith
  have hCC : c * C ≤ C := by nlinarith
  have harg : -b ≤ C + ∑ i : Fin r, (-c * max (t i) 0) := by
    rw [← Finset.mul_sum]
    nlinarith
  calc
    Real.exp (-b) ≤ Real.exp (C + ∑ i : Fin r, (-c * max (t i) 0)) :=
      Real.exp_le_exp.mpr harg
    _ = Real.exp C * ∏ i : Fin r, Real.exp (-c * max (t i) 0) := by
      rw [Real.exp_add, Real.exp_sum]

/-- One product weight controls the weighted profile on the active subspace,
with a constant allowed to depend on that profile and its supporting basis. -/
theorem supporting_weight_comparison {d : ℕ} {f : E d → ℝ}
    (hf : IsConvexProfile f) (L : ℝ) (hL : 0 ≤ L)
    (v : Fin (Module.finrank ℝ (activeSubspace f)) → E d)
    (C : Fin (Module.finrank ℝ (activeSubspace f)) → ℝ)
    (hspan : Submodule.span ℝ (range v) = activeSubspace f)
    (hC : ∀ i, 0 ≤ C i) (hle : ∀ i x, ⟪v i, x⟫ - C i ≤ f x) :
    ∃ B : ℝ, 0 < B ∧ ∀ A : ℝ, 1 ≤ A → ∀ y : activeSubspace f,
      gaussianWeight A L (y : E d) * Real.exp (-f y) ≤ B *
        ∏ i : Fin (Module.finrank ℝ (activeSubspace f)),
          oneSidedWeight (((Module.finrank ℝ (activeSubspace f) : ℝ) + 1)⁻¹)
            L (slopeCoordinateEquiv (activeSubspace f) v hspan y i) := by
  let T := slopeCoordinateEquiv (activeSubspace f) v hspan
  let K : ℝ := 1 + ‖T.symm.toContinuousLinearMap‖
  let Csum : ℝ := ∑ i, C i
  refine ⟨K ^ L * Real.exp Csum, by positivity, ?_⟩
  intro A hA y
  have hnorm : ‖(y : E d)‖ ≤ K * ∑ i, |T y i| := by
    have h := coordinate_norm_bound (activeSubspace f) v hspan (T y)
    change ‖T.symm (T y)‖ ≤ ‖T.symm.toContinuousLinearMap‖ * ∑ i, |T y i| at h
    rw [ContinuousLinearEquiv.symm_apply_apply] at h
    change ‖y‖ ≤ K * ∑ i, |T y i|
    have hKK : ‖T.symm.toContinuousLinearMap‖ ≤ K := by
      change ‖T.symm.toContinuousLinearMap‖ ≤ 1 + ‖T.symm.toContinuousLinearMap‖
      linarith
    exact h.trans (mul_le_mul_of_nonneg_right hKK
      (Finset.sum_nonneg fun i _ => abs_nonneg _))
  have hpoly := polynomial_coordinate_bound (T y) ‖(y : E d)‖ K A L
    (norm_nonneg _) (by dsimp [K]; linarith [norm_nonneg T.symm.toContinuousLinearMap]) hA hL hnorm
  have hsum : (∑ i, max (T y i) 0) ≤
      (Module.finrank ℝ (activeSubspace f) : ℝ) * f y + Csum := by
    simpa only [T, slopeCoordinateEquiv_apply, Csum] using
      positive_coordinates_sum_bound hf.2.1 v C hC hle (y : E d)
  have hexp := exponential_coordinate_bound (T y) (f y) Csum (hf.2.1 y)
    (Finset.sum_nonneg fun i _ => hC i) hsum
  have hmul := mul_le_mul hpoly hexp (Real.exp_pos _).le
    (by positivity : 0 ≤ K ^ L * ∏ i, (1 + |T y i|) ^ L)
  dsimp [gaussianWeight]
  calc
    (1 + ‖(y : E d)‖ / A) ^ L * Real.exp (-f y) ≤
      (K ^ L * ∏ i, (1 + |T y i|) ^ L) *
        (Real.exp Csum * ∏ i, Real.exp (-((Module.finrank ℝ (activeSubspace f) : ℝ) + 1)⁻¹ * max (T y i) 0)) := hmul
    _ = K ^ L * Real.exp Csum *
        ∏ i, oneSidedWeight (((Module.finrank ℝ (activeSubspace f) : ℝ) + 1)⁻¹) L (T y i) := by
      simp only [oneSidedWeight, Finset.prod_mul_distrib]
      ring


